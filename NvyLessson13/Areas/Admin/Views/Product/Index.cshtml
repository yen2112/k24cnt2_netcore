@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam text-warning me-2"></i> Danh Sách Sản Phẩm (Admin)</h2>
        <button class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Thêm Sản Phẩm Mới</button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Giá Bán</th>
                        <th>Số Lượng</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>SP001</strong></td>
                        <td>Laptop Dell XPS 13</td>
                        <td>28,500,000 VNĐ</td>
                        <td>15</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-info me-1"><i class="bi bi-pencil"></i> Sửa</button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>SP002</strong></td>
                        <td>iPhone 15 Pro Max</td>
                        <td>31,990,000 VNĐ</td>
                        <td>8</td>
                        <td><span class="badge bg-success">Còn hàng</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-info me-1"><i class="bi bi-pencil"></i> Sửa</button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>SP003</strong></td>
                        <td>Màn Hình LG UltraGear 27 inch</td>
                        <td>7,200,000 VNĐ</td>
                        <td>0</td>
                        <td><span class="badge bg-secondary">Hết hàng</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-info me-1"><i class="bi bi-pencil"></i> Sửa</button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
