@model Nvylesson14.Models.Category
@{
    ViewData["Title"] = "Xóa Danh Mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-danger mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xác Nhận Xóa Danh Mục</h3>
        <p class="text-muted mb-0">Hành động này không thể hoàn tác nếu danh mục bị xóa khỏi hệ thống.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card card-custom border-danger p-4">
            <div class="alert alert-warning">
                <i class="fa-solid fa-circle-exclamation me-2"></i>Bạn có chắc chắn muốn xóa danh mục <strong>"@Model.Name"</strong> không?
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Mã danh mục:</dt>
                <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                <dt class="col-sm-4 text-muted">Tên danh mục:</dt>
                <dd class="col-sm-8 fw-bold text-dark">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                <dd class="col-sm-8">@(Model.Status == 1 ? "Hiển thị" : "Tạm ẩn")</dd>

                <dt class="col-sm-4 text-muted">Ngày tạo:</dt>
                <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Mô tả:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "Không có" : Model.Description)</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        <i class="fa-solid fa-trash-can me-1"></i> Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-light px-3">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
