@model IEnumerable<Nvylesson14.Models.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewBag.Categories as SelectList;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Product Index</h2>
    <a asp-action="Create" class="btn btn-success">Thêm mới Product</a>
</div>

<p class="text-muted">Danh sách sản phẩm trong hệ thống</p>

<!-- Form tìm kiếm & lọc -->
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm tên sản phẩm..." />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả danh mục --</option>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <option value="@cat.Value" selected="@cat.Selected">@cat.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Tìm kiếm</button>
    </div>
</form>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá niêm yết</th>
            <th>Giá khuyến mãi</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th style="width: 200px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="9" class="text-center text-muted">Không có dữ liệu</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" width="50" height="50" style="object-fit: cover;" />
                        }
                    </td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.Category?.Name</td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td>@(item.SalePrice > 0 ? item.SalePrice.ToString("N0") + " đ" : "—")</td>
                    <td>
                        @if (item.Status == 1)
                        {
                            <span class="badge bg-success">Hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Tạm ẩn</span>
                        }
                    </td>
                    <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Xem</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
