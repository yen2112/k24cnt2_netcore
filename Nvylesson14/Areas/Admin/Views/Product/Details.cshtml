@model Nvylesson14.Models.Product
@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chi Tiết Sản Phẩm: @Model.Name</h3>
        <p class="text-muted mb-0">Mã sản phẩm: #@Model.Id</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-custom p-4 text-center">
            <img src="@Model.Image" class="rounded-3 border mb-3 mx-auto img-fluid" style="max-height: 280px; object-fit: contain;" alt="@Model.Name" onerror="this.src='https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=400'" />
            <h4 class="fw-bold mb-1">@Model.Name</h4>
            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill mb-3">
                Danh mục: @Model.Category?.Name
            </span>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-custom p-4">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Thông Tin Chi Tiết</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted mb-3">Giá niêm yết:</dt>
                <dd class="col-sm-8 fw-bold text-primary fs-5 mb-3">@Model.Price.ToString("N0") VNĐ</dd>

                <dt class="col-sm-4 text-muted mb-3">Giá khuyến mãi:</dt>
                <dd class="col-sm-8 mb-3">
                    @if (Model.SalePrice > 0 && Model.SalePrice < Model.Price)
                    {
                        <span class="fw-bold text-danger fs-5">@Model.SalePrice.ToString("N0") VNĐ</span>
                        <span class="badge bg-danger ms-2">-@Math.Round((1 - Model.SalePrice / Model.Price) * 100)%</span>
                    }
                    else
                    {
                        <span class="text-muted">Không có khuyến mãi</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted mb-3">Trạng thái:</dt>
                <dd class="col-sm-8 mb-3">
                    @if (Model.Status == 1)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-check me-1"></i>Đang hiển thị / Còn hàng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-eye-slash me-1"></i>Tạm ẩn / Hết hàng
                        </span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted mb-3">Ngày tạo:</dt>
                <dd class="col-sm-8 mb-3">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4 text-muted">Mô tả sản phẩm:</dt>
                <dd class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả" : Model.Description)</dd>
            </dl>
        </div>
    </div>
</div>
