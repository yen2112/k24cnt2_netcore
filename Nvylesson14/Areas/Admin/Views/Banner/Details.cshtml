@model Nvylesson14.Models.Banner
@{
    ViewData["Title"] = "Chi Tiết Banner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chi Tiết Banner: @Model.Name</h3>
        <p class="text-muted mb-0">Mã banner: #@Model.Id</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom p-4">
            <div class="mb-4 text-center">
                <img src="@Model.Image" class="img-fluid rounded-3 border shadow-sm" style="max-height: 280px; width: 100%; object-fit: cover;" alt="@Model.Name" onerror="this.src='https://images.unsplash.com/photo-1468495244123-6c6c332eeece?w=1200'" />
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted mb-3">Tên banner:</dt>
                <dd class="col-sm-9 fw-bold fs-5 mb-3">@Model.Name</dd>

                <dt class="col-sm-3 text-muted mb-3">Độ ưu tiên:</dt>
                <dd class="col-sm-9 mb-3">
                    <span class="badge bg-primary px-3 py-2 rounded-pill">Ưu tiên: @Model.Prioty</span>
                </dd>

                <dt class="col-sm-3 text-muted mb-3">Trạng thái:</dt>
                <dd class="col-sm-9 mb-3">
                    @if (Model.Status == 1)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-check me-1"></i>Hiển thị
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-eye-slash me-1"></i>Tạm ẩn
                        </span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Mô tả chi tiết:</dt>
                <dd class="col-sm-9 text-secondary">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả" : Model.Description)</dd>
            </dl>
        </div>
    </div>
</div>
