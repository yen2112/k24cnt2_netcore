@model Nvylesson14.Models.Blog
@{
    ViewData["Title"] = "Thêm Mới Bài Viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Thêm Mới Bài Viết / Tin Tức</h3>
        <p class="text-muted mb-0">Tạo mới bài viết tin tức công nghệ</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tiêu đề bài viết..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">Hiển thị / Công khai (Active)</option>
                            <option value="0">Tạm ẩn / Bản nháp (Draft)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CreatedDate" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedDate" type="date" class="form-control" />
                        <span asp-validation-for="CreatedDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Image" class="form-label fw-semibold"></label>
                    <input asp-for="Image" class="form-control" placeholder="Nhập đường dẫn URL ảnh đại diện bài viết..." />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập tóm tắt hoặc nội dung chính (tối đa 350 ký tự)..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-info px-4 fw-semibold text-white">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Đăng bài viết
                    </button>
                    <a asp-action="Index" class="btn btn-light px-3">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
