<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NGUYỄN VĂN YÊN Web</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Css", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light-subtle">
    <!-- Main Header Navbar -->
    <header class="sticky-top shadow-sm bg-dark">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary text-white rounded-3 px-2 py-1 me-2 shadow-sm fs-6">
                        <i class="fa-solid fa-code"></i>
                    </span>
                    <span>NGUYỄN VĂN YÊN</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1 small opacity-75"></i> Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Products">
                                <i class="fa-solid fa-store me-1 small opacity-75"></i> Sản Phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Blog">
                                <i class="fa-solid fa-newspaper me-1 small opacity-75"></i> Tin Tức
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="fa-solid fa-circle-info me-1 small opacity-75"></i> Giới Thiệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Contact">
                                <i class="fa-solid fa-envelope me-1 small opacity-75"></i> Liên Hệ
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-info rounded-pill px-3 py-2 btn-sm fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-user-shield me-1"></i> Trang Quản Trị
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="container body-content py-4 flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-4 pb-3 mt-auto border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <h6 class="fw-bold mb-1"><i class="fa-solid fa-code text-primary me-2"></i>NGUYỄN VĂN YÊN</h6>
                    <p class="text-muted small mb-0">Email: <a href="mailto:nvy2112@gmail.com" class="text-info text-decoration-none">nvy2112@gmail.com</a></p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-muted small mb-0">&copy; @DateTime.Now.Year NGUYỄN VĂN YÊN. Tất cả quyền được bảo lưu.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
