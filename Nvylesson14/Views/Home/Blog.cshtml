@model IEnumerable<Nvylesson14.Models.Blog>
@{
    ViewData["Title"] = "Tin Tức & Blog";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold"><i class="fa-solid fa-newspaper text-primary me-2"></i>Tin Tức & Bài Viết Mới</h2>
        <p class="text-muted">Cập nhật xu hướng công nghệ, kiến thức phát triển ứng dụng web hiện đại</p>
    </div>

    <div class="row g-4">
        @foreach (var blog in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                    <img src="@blog.Image" class="card-img-top object-fit-cover" style="height: 220px;" alt="@blog.Name" onerror="this.src='https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=500'">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                            <span><i class="fa-regular fa-calendar me-1"></i> @blog.CreatedDate.ToString("dd/MM/yyyy")</span>
                            <span>•</span>
                            <span class="badge bg-success-subtle text-success">Công nghệ</span>
                        </div>
                        <h5 class="card-title fw-bold text-dark mb-2">@blog.Name</h5>
                        <p class="card-text text-muted flex-grow-1">@blog.Description</p>
                        <div class="mt-3 pt-2 border-top">
                            <a href="#" class="btn btn-outline-primary btn-sm rounded-pill" onclick="alert('Xem chi tiết bài viết: @blog.Name')">
                                Đọc tiếp <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
