@model IEnumerable<Nvylesson14.Models.Product>
@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
    var categories = ViewBag.Categories as List<Nvylesson14.Models.Category> ?? new List<Nvylesson14.Models.Category>();
    int? currentCategory = ViewBag.CurrentCategory;
    string? searchString = ViewBag.SearchString;
}

<div class="container my-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="bg-primary text-white p-4 rounded-3 shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="fw-bold mb-1"><i class="fa-solid fa-store me-2"></i>Cửa Hàng Sản Phẩm</h2>
                    <p class="mb-0 opacity-75">Khám phá các thiết bị công nghệ hiện đại hàng đầu</p>
                </div>
                <form asp-action="Products" method="get" class="d-flex gap-2">
                    @if (currentCategory.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@currentCategory" />
                    }
                    <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Tìm kiếm sản phẩm..." style="min-width: 250px;" />
                    <button type="submit" class="btn btn-warning fw-semibold"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Danh mục -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-list text-primary me-2"></i>Danh Mục</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Products" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentCategory == null ? "active bg-primary border-primary" : "")">
                        <span>Tất cả sản phẩm</span>
                        <i class="fa-solid fa-angle-right small"></i>
                    </a>
                    @foreach (var cat in categories)
                    {
                        <a asp-action="Products" asp-route-categoryId="@cat.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentCategory == cat.Id ? "active bg-primary border-primary" : "")">
                            <span>@cat.Name</span>
                            <i class="fa-solid fa-angle-right small"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center py-5 shadow-sm rounded-3">
                    <i class="fa-solid fa-box-open fa-3x mb-3 text-secondary"></i>
                    <h4>Không tìm thấy sản phẩm nào!</h4>
                    <p class="text-muted">Vui lòng thử lại với từ khóa hoặc danh mục khác.</p>
                    <a asp-action="Products" class="btn btn-primary btn-sm">Xem tất cả sản phẩm</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var p in Model)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <div class="position-relative overflow-hidden">
                                    <img src="@p.Image" class="card-img-top object-fit-cover" style="height: 220px;" alt="@p.Name" onerror="this.src='https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=400'">
                                    @if (p.SalePrice > 0 && p.SalePrice < p.Price)
                                    {
                                        var discount = Math.Round((1 - p.SalePrice / p.Price) * 100);
                                        <span class="position-absolute top-0 end-0 badge bg-danger m-2 px-2 py-1 shadow-sm">
                                            -@discount%
                                        </span>
                                    }
                                    <span class="position-absolute bottom-0 start-0 badge bg-dark bg-opacity-75 m-2">
                                        @p.Category?.Name
                                    </span>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title fw-bold text-truncate" title="@p.Name">@p.Name</h6>
                                    <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@p.Description</p>
                                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            @if (p.SalePrice > 0 && p.SalePrice < p.Price)
                                            {
                                                <div class="fw-bold text-danger">@p.SalePrice.ToString("N0") đ</div>
                                                <div class="text-muted text-decoration-line-through small" style="font-size: 0.75rem;">@p.Price.ToString("N0") đ</div>
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-primary">@p.Price.ToString("N0") đ</div>
                                            }
                                        </div>
                                        <button class="btn btn-sm btn-primary rounded-pill px-3" onclick="alert('Đã thêm sản phẩm vào giỏ hàng!')">
                                            <i class="fa-solid fa-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
