@model IEnumerable<NvyLesson10EFDbFist.Model.NvyMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NvyUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NvyPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NvyFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NvyEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NvyPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NvyStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NvyUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.NvyPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.NvyFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.NvyEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.NvyPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.NvyStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
