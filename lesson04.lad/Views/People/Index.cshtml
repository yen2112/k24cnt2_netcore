@model IEnumerable<lesson04.lad.Models.People>

@{
    ViewData["Title"] = "Danh sách người dùng (People)";
}

<h2>Index</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Address)</th>
            <th>@Html.DisplayNameFor(model => model.Avatar)</th>
            <th>@Html.DisplayNameFor(model => model.Birthday)</th>
            <th>@Html.DisplayNameFor(model => model.Bio)</th>
            <th>@Html.DisplayNameFor(model => model.Gender)</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
            <td>@Html.DisplayFor(modelItem => item.Address)</td>
            <td>
                @if (!string.IsNullOrEmpty(item.Avatar))
                {
                    <img src="~/@item.Avatar" alt="@item.Name" style="width:60px; height:60px; object-fit:cover;" class="img-thumbnail" />
                }
            </td>
            <td>@item.Birthday.ToString("dd/MM/yyyy")</td>
            <td>@Html.DisplayFor(modelItem => item.Bio)</td>
            <td>
                @if (item.Gender == 0)
                {
                    <span>Nam</span>
                }
                else if (item.Gender == 1)
                {
                    <span>Nữ</span>
                }
                else
                {
                    <span>Khác</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success btn-sm">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
