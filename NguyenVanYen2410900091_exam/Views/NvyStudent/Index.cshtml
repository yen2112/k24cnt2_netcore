@model IEnumerable<NguyenVanYen2410900091_exam.Models.nvyStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container my-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">DANH SÁCH SINH VIÊN (HvtStudent)</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Thêm sinh viên mới</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtName)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtGender)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtBirthDay)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtEmail)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtPhone)</th>
                    <th>@Html.DisplayNameFor(model => model.HvtActive)</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model) {
                    <tr>
                        <td class="text-center">@item.Id</td>
                        <td class="fw-bold">@item.HvtName</td>
                        <td class="text-center">@item.HvtGender</td>
                        <td class="text-center">@item.HvtBirthDay.ToString("dd/MM/yyyy")</td>
                        <td>@item.HvtEmail</td>
                        <td>@item.HvtPhone</td>
                        <td class="text-center">
                            @if (item.HvtActive)
                            {
                                <span class="badge bg-success">Đang học</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm dừng</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Chi tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Chưa có dữ liệu sinh viên nào.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
