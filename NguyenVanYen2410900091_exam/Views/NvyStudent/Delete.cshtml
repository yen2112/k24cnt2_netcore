@model NguyenVanYen2410900091_exam.Models.nvyStudent

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container my-3">
    <h2 class="text-danger">Xóa thông tin sinh viên</h2>
    <h4 class="text-muted">Bạn có chắc chắn muốn xóa sinh viên này không?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.HvtName)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtGender)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.HvtGender)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtBirthDay)
        </dt>
        <dd class="col-sm-9">
            @Model.HvtBirthDay.ToString("dd/MM/yyyy")
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtEmail)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.HvtEmail)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtPhone)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.HvtPhone)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.HvtActive)
        </dt>
        <dd class="col-sm-9">
            @if (Model.HvtActive)
            {
                <span class="badge bg-success">Đang học</span>
            }
            else
            {
                <span class="badge bg-secondary">Tạm dừng</span>
            }
        </dd>
    </dl>
    
    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Hủy / Quay lại</a>
    </form>
</div>
